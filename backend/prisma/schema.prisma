generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id                  Int          @id @default(autoincrement())
  name                CategoryName @unique
  description         String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  trainings           Training[]
  resources           Resource[]
  approvedStudents    User[]       @relation("ApprovedCategory")
  preferredByStudents User[]       @relation("PreferredCategory")

  @@map("categories")
}

model User {
  id                  Int                  @id @default(autoincrement())
  firstName           String
  lastName            String
  email               String               @unique
  passwordHash        String?
  googleId            String?              @unique
  role                Role                 @default(STUDENT)
  status              UserStatus           @default(PENDING)
  department          String
  academicYear        String
  preferredCategoryId Int
  approvedCategoryId  Int?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  lessonCompletions   LessonCompletion[]
  trainings           Training[]
  resources           Resource[]
  approvedCategory    Category?            @relation("ApprovedCategory", fields: [approvedCategoryId], references: [id])
  preferredCategory   Category             @relation("PreferredCategory", fields: [preferredCategoryId], references: [id])
  accessGrants        TrainingAccessGrant[] // Student: trainings granted to them
  grantedAccessGrants TrainingAccessGrant[] @relation("AccessGranter") // Admin: trainings they granted

  @@map("users")
}

model Resource {
  id          Int          @id @default(autoincrement())
  title       String
  type        ResourceType
  fileUrl     String?
  linkUrl     String?
  categoryId  Int
  trainingId  Int?
  createdById Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  category    Category     @relation(fields: [categoryId], references: [id])
  training    Training?    @relation(fields: [trainingId], references: [id])
  createdBy   User         @relation(fields: [createdById], references: [id])

  @@map("resources")
}

model LessonCompletion {
  id          Int       @id @default(autoincrement())
  userId      Int
  lessonId    Int
  trainingId  Int
  completedAt DateTime  @default(now())
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  training    Training  @relation(fields: [trainingId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, lessonId])
  @@map("lesson_completions")
}

model Lesson {
  id                Int                @id @default(autoincrement())
  title             String
  content           String
  imageUrl          String?
  order             Int                @default(0)
  moduleId          Int
  createdAt         DateTime           @default(now())
  updatedAt         DateTime
  lessonCompletions LessonCompletion[]
  module            Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("lessons")
}

model Module {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  order       Int       @default(0)
  trainingId  Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  lessons     Lesson[]
  training    Training  @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@map("modules")
}

model Training {
  id                Int                   @id @default(autoincrement())
  title             String
  description       String
  thumbnail         String?
  difficulty        Difficulty            @default(BEGINNER)
  status            TrainingStatus        @default(DRAFT)
  order             Int                   @default(0)
  unlockType        UnlockType            @default(OPEN)
  categoryId        Int
  createdById       Int
  createdAt         DateTime              @default(now())
  updatedAt         DateTime
  lessonCompletions LessonCompletion[]
  modules           Module[]
  resources         Resource[]
  category          Category              @relation(fields: [categoryId], references: [id])
  createdBy         User                  @relation(fields: [createdById], references: [id])
  accessGrants      TrainingAccessGrant[]

  @@map("trainings")
}

model TrainingAccessGrant {
  id          Int      @id @default(autoincrement())
  trainingId  Int
  userId      Int
  grantedAt   DateTime @default(now())
  grantedById Int
  training    Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])
  grantedBy   User     @relation("AccessGranter", fields: [grantedById], references: [id])

  @@unique([trainingId, userId])
  @@map("training_access_grants")
}

enum Role {
  STUDENT
  CATEGORY_ADMIN
  MAIN_ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum CategoryName {
  CYBERSECURITY
  DEVELOPMENT
  NETWORKING
  CREATIVE_WORKS
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TrainingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum UnlockType {
  OPEN
  SEQUENTIAL
  MANUAL
}

enum ResourceType {
  CATEGORY
  TRAINING
}
